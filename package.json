{
  "name": "bodlife-api",
  "version": "1.0.0",
  "description": "BodLife Lifestyle Tracking API - workouts, weight, meals, progressive overload",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "postinstall": "prisma generate",
    "build": "tsc",
    "build:client": "cd client && npm install --include=dev && npm run build",
    "build:all": "npm run build:client && npm run build",
    "start": "node dist/server.js",
    "serve": "npm run build:all && npm start",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@types/validator": "^13.12.2",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "express-rate-limit": "7.4.1",
    "express-validator": "7.2.0",
    "google-auth-library": "^9.15.1",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "lucide-react": "^1.26.0",
    "morgan": "1.10.0",
    "prisma": "5.22.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "9.0.7",
    "@types/morgan": "1.9.9",
    "@types/node": "22.9.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "jest": "^30.4.2",
    "jest-mock-extended": "^4.0.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "2.0.0",
    "typescript": "5.6.3"
  }
}
