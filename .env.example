# Database
DATABASE_URL="postgresql://user:password@localhost:5432/botlife"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Google OAuth (Sign in with Google) — from Google Cloud Console > Credentials
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# Server
PORT=3000
NODE_ENV="development"

# Rate limiting (global — skipped entirely in development)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
