# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bodlife"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Google OAuth (Sign in with Google) — from Google Cloud Console > Credentials
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# Server
PORT=3000
NODE_ENV="development"

# Public base URL the server runs at — used to build links in emails (e.g.
# the password reset link). Falls back to the request's own host if unset.
APP_URL="http://localhost:3000"

# Password reset emails — from https://resend.com (free tier is plenty for
# this app). Without RESEND_API_KEY, reset links are logged to the console
# instead of emailed, so the flow still works in local development.
RESEND_API_KEY=""
EMAIL_FROM="BodLife <onboarding@resend.dev>"

# Rate limiting (global — skipped entirely in development)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# AI chat (workout plan generation) — from https://aistudio.google.com/apikey
# (Gemini has a free tier that's plenty for this feature). Without this key,
# the chat endpoint returns 503 instead of crashing the server.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
