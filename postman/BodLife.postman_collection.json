    {
      "name": "Chat - Rate Limit (slow, run separately)",
      "item": [
        {
          "name": "31 requests in a window: the 31st is blocked (429)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// This request counts as call #1 for the current user's 15-minute",
                  "// window (30 requests/window, see chat.routes.ts). It fires 30 more",
                  "// via pm.sendRequest and asserts the last one (#31) is rate-limited.",
                  "// Slow (~31 sequential round trips) and mutates rate-limit state for",
                  "// {{token}}'s user, so it's kept out of the default \"Chat - Workout",
                  "// Plan\" folder — run this folder on its own.",
                  "",
                  "pm.test('request #1 succeeds', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const url = pm.environment.get('baseUrl') + '/api/chat/workout-plan';",
                  "const token = pm.environment.get('token');",
                  "const requestOptions = {",
                  "    url: url,",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ messages: [{ role: 'user', text: 'ping' }] }) }",
                  "};",
                  "",
                  "function fireSequentially(remaining, onDone) {",
                  "    if (remaining <= 0) { onDone(); return; }",
                  "    pm.sendRequest(requestOptions, function (_err, res) {",
                  "        fireSequentially(remaining - 1, onDone);",
                  "    });",
                  "}",
                  "",
                  "// 29 more \"warm-up\" calls (#2-#30), then a final call (#31) that",
                  "// should be blocked.",
                  "fireSequentially(29, function () {",
                  "    pm.sendRequest(requestOptions, function (_err, res) {",
                  "        pm.test('request #31 is rate-limited (429)', function () {",
                  "            pm.expect(res.code).to.equal(429);",
                  "        });",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [{ \"role\": \"user\", \"text\": \"ping\" }]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat/workout-plan",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chat", "workout-plan"]
            }
          },
          "response": []
        }
      ]
