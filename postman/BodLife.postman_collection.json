  "info": {
    "_postman_id": "b0d1f3a0-0000-4c00-8a00-a1c2e3f4d5b6",
    "name": "BodLife - AI Chat Integration Tests",
    "description": "Integration tests for the Gemini-powered workout plan chatbot (POST /api/chat/workout-plan) and its guardrails.\n\nRequires:\n- The BodLife server running locally (`npm run dev`) with `DATABASE_URL` and `GEMINI_API_KEY` configured.\n- The `BodLife Local` environment selected.\n\nRun order matters within \"Auth\" and \"Chat - Workout Plan\" (Register must run first to set {{token}}). In Postman, use the Collection Runner; from the CLI, use `npm run test:api` (newman).\n\nRequests in \"Chat - Workout Plan\" that don't test a validation failure make real calls to the Gemini API and will incur usage against your key.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register throwaway test user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('response includes a JWT token', function () {",
                  "    pm.expect(json.data.token).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.environment.set('token', json.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{$randomEmail}}\",\n  \"password\": \"TestPass123!\",\n  \"name\": \"Postman Test User\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "response": []
        }
      ]
    },
