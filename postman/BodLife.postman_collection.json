        {
          "name": "6. Enough info in one message produces a saveable plan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "const plan = json.data.plan;",
                  "",
                  "pm.test('a plan is drafted', function () {",
                  "    pm.expect(plan).to.be.an('object');",
                  "});",
                  "",
                  "pm.test('plan matches the ImportedPlan shape the client expects', function () {",
                  "    pm.expect(plan.name).to.be.a('string').and.not.empty;",
                  "    pm.expect(['Beginner', 'Intermediate', 'Advanced']).to.include(plan.difficulty);",
                  "    pm.expect(['Strength', 'Hypertrophy', 'Fat Loss', 'General Fitness']).to.include(plan.goal);",
                  "    pm.expect(plan.days).to.be.an('array').with.length.greaterThan(0);",
                  "});",
                  "",
                  "pm.test('every day has at least one exercise with at least one set', function () {",
                  "    plan.days.forEach((day) => {",
                  "        pm.expect(day.exercises).to.be.an('array').with.length.greaterThan(0);",
                  "        day.exercises.forEach((ex) => {",
                  "            pm.expect(ex.sets).to.be.an('array').with.length.greaterThan(0);",
                  "        });",
                  "    });",
                  "});",
                  "",
                  "pm.test('compute guardrail: plan stays within clamped bounds (<=7 days, <=10 exercises/day, <=10 sets/exercise)', function () {",
                  "    pm.expect(plan.days.length).to.be.at.most(7);",
                  "    plan.days.forEach((day) => {",
                  "        pm.expect(day.exercises.length).to.be.at.most(10);",
                  "        day.exercises.forEach((ex) => pm.expect(ex.sets.length).to.be.at.most(10));",
                  "    });",
                  "});"
                ]
              }
            }
          ],
